        {
          "widget": {
            "name": "09117165",
            "multilineTextboxSpec": {
              "lines": [
                "<span style=\"font-weight:700;font-size:18px\">Regra de negócio para segmentação</span><br><span style=\"font-size:14px\">Divisão da base de clientes em 5 grupos de tamanhos parecidos, com scores de 1 a 5 para recência e para faturamento.</span><br><br><span style=\"font-size:14px\">Como foram definidos os segmentos? A partir dos scores, temos:</span><br><span style=\"font-size:14px\">- Frequência de compra > 1 & Score recência >= 4 -- \"Recorrentes ativos\"</span><br><span style=\"font-size:14px\">- Score recência >= 4 & Score faturamento >= 4 -- \"Novos de alto valor\"</span><br><span style=\"font-size:14px\">- Score recência <= 2 & Score faturamento >= 4 -- \"Alto valor em risco\"</span><br><span style=\"font-size:14px\">- Score recência <= 2  -- \"Inativos\"</span><br><span style=\"font-size:14px\">- Demais -- \"Base regular\"</span>"
              ]
            }
          },
          "position": {
            "x": 0,
