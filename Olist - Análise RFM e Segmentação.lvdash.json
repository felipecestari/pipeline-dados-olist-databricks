{
  "datasets": [
    {
      "name": "5ed58c42",
      "displayName": "Segmentação",
      "queryLines": [
        "USE CATALOG `workspace`;\n",
        "USE SCHEMA `default`;\n",
        "\n",
        "SELECT\n",
        "segmento,\n",
        "COUNT(*) AS clientes,\n",
        "ROUND(SUM(monetario), 0) AS receita,\n",
        "SUM(monetario) / COUNT(*) AS ticket_medio,\n",
        "ROUND(AVG(parcelas_medias), 1) AS parcelas_medias,\n",
        "AVG(usou_cartao) AS pct_cartao\n",
        "\n",
        "FROM workspace.olist.gold_rfm\n",
        "\n",
        "GROUP BY segmento"
      ]
    },
    {
      "name": "00d5f8f3",
      "displayName": "UF",
      "queryLines": [
        "USE CATALOG `workspace`;\n",
        "USE SCHEMA `default`;\n",
        "\n",
        "SELECT *,\n",
        "qde_usou_cartao/qde_pedidos AS `taxa_uso_cartao_credito`\n",
        "FROM workspace.olist.gold_clientes_uf"
      ]
    },
    {
      "name": "fe4713b8",
      "displayName": "Resumo",
      "queryLines": [
        "USE CATALOG `workspace`;\n",
        "USE SCHEMA `default`;\n",
        "\n",
        "SELECT *,\n",
        "qde_usou_cartao/qde_pedidos AS `taxa_uso_cartao_credito`\n",
        "FROM workspace.olist.gold_clientes_resumo"
      ]
    }
  ],
